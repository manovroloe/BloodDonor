# Local development. For the public website, change the production settings below.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=false
PUBLIC_ORIGIN=
ALLOWED_HOSTS=
WORKERS=1
LOG_LEVEL=info
MAX_UPLOAD_MB=10
# Trust only your actual reverse proxy. Do not use * on an exposed server.
FORWARDED_ALLOW_IPS=127.0.0.1

# PRODUCTION requires all of the following:
# APP_ENV=production
# PUBLIC_ORIGIN=https://your-real-domain.example
# COOKIE_SECURE=true
# ALLOWED_HOSTS=your-real-domain.example,localhost,127.0.0.1
# HTTPS must terminate at your hosting provider, reverse proxy, or tunnel.

