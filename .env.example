# Private SERVER settings. Never place this file inside client/.
# Reuse your existing v22 .env, or fill in these values once.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional privileged Auth key: required only for admin staff creation/password resets.
# Keep it on the server; ordinary database queries NEVER use it.
SUPABASE_SERVICE_ROLE_KEY=
# New-style keys are also supported under these aliases instead of the legacy names:
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Local development. For the public website, change the production settings below.
APP_ENV=development
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=false
PUBLIC_ORIGIN=
ALLOWED_HOSTS=
WORKERS=1
LOG_LEVEL=info
MAX_UPLOAD_MB=10
# Trust only your actual reverse proxy. Do not use * on an exposed server.
FORWARDED_ALLOW_IPS=127.0.0.1

# PRODUCTION requires all of the following:
# APP_ENV=production
# PUBLIC_ORIGIN=https://your-real-domain.example
# COOKIE_SECURE=true
# ALLOWED_HOSTS=your-real-domain.example,localhost,127.0.0.1
# HTTPS must terminate at your hosting provider, reverse proxy, or tunnel.

# Optional outgoing email, used by admin contact-message replies.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BloodCare
SMTP_USE_TLS=true

# Secret files may be used instead of environment values, e.g.:
# SUPABASE_SERVICE_ROLE_KEY_FILE=/run/secrets/supabase_service_role_key
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
